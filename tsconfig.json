{
    "compilerOptions": {
        "outDir": "lib",
        "rootDir": "src",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2017",
        "strict": false,
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noEmitHelpers": true,
        "removeComments": true,
        "preserveConstEnums": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "declaration": true,
        "types": [
            "node"
        ],
        "lib": [
            "es2017",
            "dom"
        ]
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "../../node_modules"
    ]
}